# ==============================================================================
# unkernel-nvim 服务端环境变量配置模板 (复制为 .env 后修改，切勿将真实密钥提交到 Git)
# ==============================================================================

# 运行环境: production 会默认启用严格的公网安全域名白名单
NODE_ENV=production

# 监听地址与端口
HOST=0.0.0.0
PORT=3000
WISP_PATH=/wisp

# 公网部署的独立 Guest 端口预览站点目录，本地回环自动配置
# GUEST_PREVIEW_URL=https://preview.example.com/unkernel-nvim/

# 从 GHCR 部署时，填入已发布的完整版本号或镜像摘要
# UNKERNEL_NVIM_IMAGE=ghcr.io/vod-studio/unkernel-nvim:0.1.0

# 如果运行在 Nginx / Caddy / Cloudflare 反向代理之后，务必设为 true
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 1. 服务器 <-> 独立 Wisp 服务认证（密钥仅保存在服务端环境变量，前端完全不可见）
# ------------------------------------------------------------------------------
# 留空 WISP_UPSTREAM_URL 则在应用服务器进程内直接内置运行 Wisp；
# 填入上游地址（如 Docker 内网 ws://wisp:6680/wisp 或独立 VPS wss://...）则自动切换为网关转发模式：
# WISP_UPSTREAM_URL=ws://wisp:6680/wisp

# 独立 Wisp 服务的强密钥（生成示例: openssl rand -hex 32）
# - 独立 Wisp 服务 (`bun run wisp`) 强制校验 `Authorization: Bearer <WISP_AUTH_TOKEN>`
# - 应用服务器网关在服务端自动携带该 Token 连接 WISP_UPSTREAM_URL
WISP_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# 独立 Wisp 服务监听端口 (仅 `bun run wisp` 使用)
WISP_PORT=6680

# ------------------------------------------------------------------------------
# 2. 浏览器 <-> 应用服务器（无需登录，无感短效 HttpOnly 会话 Cookie + Origin 校验）
# ------------------------------------------------------------------------------
# HMAC 签名密钥（不填则每次启动随机生成；多实例部署建议固定为 32 字节随机值）
# SESSION_SECRET=replace-with-another-random-secret
SESSION_TTL_SECONDS=7200
WISP_REQUIRE_SESSION=true

# 额外允许的浏览器 Origin（逗号分隔，同源默认自动放行）
# WISP_ALLOWED_ORIGINS=https://nvim.example.com

# ------------------------------------------------------------------------------
# 3. 出口安全策略（公网无登录模式核心防线）
# ------------------------------------------------------------------------------
# 允许代理访问的目标域名白名单（逗号分隔，支持 *.example.com；设为 * 则放行任意公网域名）
# 生产环境不填时默认放行 GitHub / Alpine / GitLab / Codeberg / npm / PyPI / Crates / Go Proxy
# WISP_ALLOWED_HOSTS=github.com,*.github.com,*.githubusercontent.com,dl-cdn.alpinelinux.org,*.alpinelinux.org,deb.debian.org,security.debian.org

# 允许代理访问的目标端口（逗号分隔；设为 * 仍会默认屏蔽 25/465/587 等邮件端口）
WISP_ALLOWED_PORTS=80,443

# 反 SSRF：禁止访问回环 / 内网 / 云厂商 Metadata IP（公网务必保持 false）
WISP_ALLOW_PRIVATE=false

# 可选：若服务器本身需经由上游 HTTP CONNECT 代理访问外网（如 http://127.0.0.1:7890）
# 未显式设置 WISP_OUTBOUND_PROXY 时，默认自动读取环境变量 HTTPS_PROXY / HTTP_PROXY / ALL_PROXY（仅 http/https）与 NO_PROXY
# 如需禁用环境变量代理读取，请设为 WISP_USE_ENV_PROXY=false
# WISP_OUTBOUND_PROXY=
# WISP_USE_ENV_PROXY=true
# WISP_NO_PROXY=

# ------------------------------------------------------------------------------
# 4. 限流与连接配额
# ------------------------------------------------------------------------------
WISP_MAX_CONNECTIONS_PER_IP=4
WISP_MAX_CONNECTS_PER_MIN_PER_IP=30
WISP_MAX_STREAMS_PER_WS=32
WISP_MAX_TOTAL_STREAMS=512
WISP_CONNECT_TIMEOUT_MS=10000
WISP_IDLE_TIMEOUT_SEC=120
