{
  "name": "unkernel-nvim",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance fullscreen browser Neovim powered by unkernel (Alpine riscv64 + DefectingCat/nvim)",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prebake": "bun scripts/prebake.ts",
    "dev": "bunx --bun vite",
    "build": "bunx --bun tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "start": "bun server/index.ts",
    "wisp": "bun server/wisp-server.ts"
  },
  "dependencies": {
    "@vod-studio/unkernel": "0.1.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
