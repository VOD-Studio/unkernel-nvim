[Unit]
Description=unkernel-nvim web app and Wisp service
Wants=network-online.target
After=network-online.target podman.socket nginx-proxy.service
Requires=podman.socket nginx-proxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/docker/unkernel-nvim
ExecStart=/usr/local/bin/podman-compose -f docker-compose.yml -f deploy/rua/compose.yml up -d --no-build --pull never --wait --wait-timeout 120
ExecStop=/usr/local/bin/podman-compose -f docker-compose.yml -f deploy/rua/compose.yml stop
TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
